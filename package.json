{
  "name": "fuelltreffer",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port ${FRONTEND_PORT:-4000}",
    "start": "astro dev --port ${FRONTEND_PORT:-4000}",
    "build": "astro check && astro build",
    "preview": "astro preview --port ${FRONTEND_PORT:-4000}",
    "astro": "astro",
    "build:docker": "docker build -t fuelltreffer .",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/node": "^8.3.4",
    "@astrojs/svelte": "^6.0.2",
    "@astrojs/tailwind": "^5.1.0",
    "@stomp/stompjs": "^7.3.0",
    "astro": "^4.15.0",
    "leaflet": "1.9.4",
    "sockjs-client": "^1.6.1",
    "svelte": "^5.38.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.1",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-svelte": "^3.12.1"
  }
}
