
# Public domain used by docker-compose.production.yml (without https://)
APP_DOMAIN=darts.sc-oberfuellbach.de

# Local development / Docker Compose host port
FRONTEND_PORT=4000

# 2k Software API (also the server default)
TWOK_SOFTWARE_API_URL=https://backend4.2k-dart-software.com/2k-backend4/api/v1/frontend

# Optional Umami Analytics; leave empty to disable tracking.
# PUBLIC_* values must be available when running npm run build.
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_WEBSITE_ID=
