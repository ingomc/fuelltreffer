---
// Header.astro - Sticky Navigation Header
import { CURRENT_LEAGUE } from '../config/league';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeSwitch from './svelte/ThemeSwitch.svelte';

interface Props {
  showTeamSelector?: boolean;
}
const { showTeamSelector = true } = Astro.props;
const ligaTeams = CURRENT_LEAGUE.teams;

// Get current team from URL parameter
const url = new URL(Astro.request.url);
const selectedTeamId = url.searchParams.get('team') || CURRENT_LEAGUE.defaultParticipantId;
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Dashboard', icon: 'dashboard' as const, active: pathname === '/' || pathname.startsWith('/match/') },
  { href: '/spielorte', label: 'Spielorte', icon: 'map' as const, active: pathname.startsWith('/spielorte') },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-200/70 bg-white/75 backdrop-blur-xl supports-[backdrop-filter]:bg-white/60 dark:border-white/[0.06] dark:bg-zinc-950/70 dark:supports-[backdrop-filter]:bg-zinc-950/55">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex shrink-0 items-center gap-2.5 rounded-xl" title="Zur Startseite">
      <Logo size={32} class="transition-transform duration-300 group-hover:-rotate-12" />
      <span class="hidden flex-col leading-none min-[400px]:flex">
        <span class="font-display text-[17px] font-bold tracking-tight text-zinc-900 dark:text-white">Fülltreffer</span>
        <span class="mt-0.5 text-[10px] font-medium uppercase tracking-[0.16em] text-zinc-500 dark:text-zinc-400">{CURRENT_LEAGUE.name}</span>
      </span>
    </a>

    <nav aria-label="Hauptnavigation" class="ml-4 hidden items-center gap-1 md:flex">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
            item.active
              ? 'bg-zinc-900/5 text-zinc-900 dark:bg-white/10 dark:text-white'
              : 'text-zinc-500 hover:bg-zinc-900/5 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-white/5 dark:hover:text-white',
          ]}
        >
          <Icon name={item.icon} size={15} />
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex min-w-0 items-center gap-2">
      {showTeamSelector && (
        <label class="relative flex min-w-0 items-center">
          <span class="sr-only">Team auswählen</span>
          <span class="pointer-events-none absolute left-3 text-brand-500 dark:text-brand-400">
            <Icon name="users" size={15} />
          </span>
          <select
            id="header-team-select"
            class="h-9 w-full min-w-0 max-w-[48vw] cursor-pointer appearance-none truncate rounded-xl border border-zinc-200 bg-white/80 py-0 pl-9 pr-8 text-sm font-medium text-zinc-900 shadow-sm transition-colors hover:border-zinc-300 sm:max-w-[280px] dark:border-white/10 dark:bg-white/5 dark:text-zinc-100 dark:hover:border-white/20 [&>option]:bg-white [&>option]:text-zinc-900 dark:[&>option]:bg-zinc-900 dark:[&>option]:text-zinc-100"
          >
            {ligaTeams.map(team => (
              <option value={team.id} selected={team.id === selectedTeamId}>
                {team.name}
              </option>
            ))}
          </select>
          <span class="pointer-events-none absolute right-2.5 text-zinc-400">
            <Icon name="chevron-down" size={15} />
          </span>
        </label>
      )}

      <a
        href="/spielorte"
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-zinc-200 bg-white/80 text-zinc-600 hover:text-zinc-900 md:hidden dark:border-white/10 dark:bg-white/5 dark:text-zinc-300 dark:hover:text-white"
        aria-label="Spielorte"
        title="Spielorte"
      >
        <Icon name="map" size={16} />
      </a>

      <ThemeSwitch client:load />
    </div>
  </div>
</header>

<script>
  // Handle team selection change
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('header-team-select');
    if (select) {
      select.addEventListener('change', (event) => {
        const selectedTeamId = (event.target as HTMLSelectElement).value;
        if (selectedTeamId) {
          // Navigate to URL with team parameter, preserve existing tab parameter
          const url = new URL(window.location.href);
          url.searchParams.set('team', selectedTeamId);
          // Keep existing tab parameter if present
          window.location.href = url.toString();
        }
      });
    }

  });
</script>
