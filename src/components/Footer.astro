---
import { Image } from 'astro:assets';
import avatarImage from '../assets/andre-emoji.png';
import { CURRENT_LEAGUE_TITLE } from '../config/league';
---

<footer class="divider mt-10 border-t">
  <div class="flex flex-wrap items-center justify-between gap-4 px-4 py-5 sm:px-6 lg:px-9">
    <p class="dimmed text-xs">Fülltreffer Dashboard · {CURRENT_LEAGUE_TITLE}</p>
    <a
      href="https://andre-bellmann.de"
      target="_blank"
      rel="noopener noreferrer"
      class="dimmed group flex items-center gap-2.5 rounded-md text-xs"
    >
      <Image
        src={avatarImage}
        alt="Andre Bellmann Avatar"
        width={28}
        height={28}
        densities={[1, 2]}
        quality={95}
        format="webp"
        class="h-7 w-7 rounded-full bg-gray-100 object-cover dark:bg-dark-500"
        loading="lazy"
        decoding="async"
      />
      <span>Made with ♥ by <span class="heading font-semibold group-hover:underline">Andre Bellmann</span> · © {new Date().getFullYear()}</span>
    </a>
  </div>
</footer>
