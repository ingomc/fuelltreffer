---
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = '' } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" class={className} aria-hidden="true">
  <defs>
    <linearGradient id="logo-bg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#818cf8" />
      <stop offset="1" stop-color="#4338ca" />
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill="url(#logo-bg)" />
  <circle cx="16" cy="16" r="10" fill="none" stroke="white" stroke-opacity="0.35" stroke-width="2" />
  <circle cx="16" cy="16" r="5.5" fill="none" stroke="white" stroke-opacity="0.7" stroke-width="2" />
  <circle cx="16" cy="16" r="2" fill="#34d399" />
  <path d="M16 16 25 7" stroke="white" stroke-width="2" stroke-linecap="round" />
  <path d="M23 6.5h3v3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
