---
import Layout from '../../../../layouts/Layout.astro';
import LiveScoring from '../../../../components/svelte/LiveScoring.svelte';
import Icon from '../../../../components/Icon.astro';
import { CURRENT_LEAGUE, CURRENT_LEAGUE_TITLE, findLeagueTeam } from '../../../../config/league';
import { THREE_K_USER_AGENT } from '../../../../config/threek';
import { isNumericId } from '../../../../lib/threek-proxy';

const { eventId, matchId } = Astro.params;

if (!isNumericId(eventId) || !isNumericId(matchId)) {
  return new Response('Matchbericht nicht gefunden', {
    status: 404,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' }
  });
}

// Team parameter for back navigation and roster; only teams of this league count
const teamParam = findLeagueTeam(Astro.url.searchParams.get('team'))?.id ?? null;
const backUrl = teamParam ? `/?team=${teamParam}` : '/';

type MatchParticipant = {
  id?: string | number;
  displayName?: string;
};

type MatchSummary = {
  id?: string | number;
  participantHome?: MatchParticipant;
  participantGuest?: MatchParticipant;
};

type ParticipantResponse = {
  matches?: MatchSummary[];
};

function getShortTeamName(participant?: MatchParticipant) {
  if (!participant) return null;

  return CURRENT_LEAGUE.teams.find((team) => team.id === String(participant.id))?.shortName
    ?? participant.displayName
    ?? null;
}

let matchTitle = 'Matchbericht';
let matchDescription = 'Details zu diesem Dart-Match.';
let initialMatchSummary: MatchSummary | null = null;

// Match reports contain their team information only after the report has been
// started. The participant endpoint always provides the match pairing.
if (teamParam) {
  try {
    const apiBaseUrl = process.env.TWOK_SOFTWARE_API_URL || CURRENT_LEAGUE.api.twokSoftwareBaseUrl;
    const response = await fetch(`${apiBaseUrl}/participant/${teamParam}`, {
      headers: {
        'User-Agent': THREE_K_USER_AGENT
      }
    });

    if (response.ok) {
      const participantData = await response.json() as ParticipantResponse;
      const match = participantData.matches?.find((candidate) => String(candidate.id) === String(matchId));
      initialMatchSummary = match ?? null;
      const homeTeamName = getShortTeamName(match?.participantHome);
      const awayTeamName = getShortTeamName(match?.participantGuest);

      if (homeTeamName && awayTeamName) {
        matchTitle = `Matchbericht: ${homeTeamName} vs. ${awayTeamName}`;
        matchDescription = `Matchbericht von ${homeTeamName} gegen ${awayTeamName} in der ${CURRENT_LEAGUE.name}.`;
      }
    }
  } catch (error) {
    console.warn(`[match-report] Could not load title data for match ${matchId}:`, error);
  }
}
---

<Layout title={matchTitle} description={matchDescription}>
  <div class="mx-auto flex w-full max-w-[1100px] flex-col gap-5 px-4 pt-6 sm:px-6 lg:px-9 lg:pt-7">
    <!-- Header with back button -->
    <div id="match-page-header" class="flex items-center gap-3">
      <a href={backUrl} class="btn-default w-11 shrink-0 px-0" aria-label="Zurück zum Dashboard" title="Zurück zum Dashboard">
        <Icon name="arrow-left" size={18} strokeWidth={1.6} />
      </a>
      <div class="flex min-w-0 flex-col gap-0.5">
        <span class="label">{CURRENT_LEAGUE_TITLE}</span>
        <h1 class="heading text-2xl font-bold leading-tight sm:text-[28px]">Matchbericht</h1>
      </div>
    </div>

    <LiveScoring client:load databaseId={CURRENT_LEAGUE.api.databaseId} matchId={matchId} />

    <div id="match-report-container" data-event-id={eventId} data-match-id={matchId} data-team={teamParam}>
      <!-- Loading state -->
      <div id="loading" class="flex flex-col gap-5" aria-busy="true" aria-label="Matchbericht wird geladen">
        <div class="skeleton h-52 rounded-xl"></div>
        <div class="skeleton h-64 rounded-xl"></div>
        <div class="skeleton h-64 rounded-xl"></div>
      </div>

      <!-- Error state -->
      <div id="error" class="paper hidden flex-col items-center px-6 py-12 text-center" role="alert">
        <span class="text-loss-700 dark:text-loss-400"><Icon name="alert" size={28} strokeWidth={1.5} /></span>
        <p class="heading mt-3 font-semibold">Fehler beim Laden des Match Reports</p>
        <p id="error-message" class="dimmed mt-1"></p>
        <a href={backUrl} class="btn-default mt-5">
          <Icon name="arrow-left" size={16} strokeWidth={1.6} /> Zurück zum Dashboard
        </a>
      </div>

      <!-- Content -->
      <div id="content" class="hidden space-y-5"></div>
    </div>
  </div>
</Layout>

<script>
  import { trackEvent, trackDartEvents } from '../../../../utils/umami.js';

  // Values rendered by Astro onto the report container
  const { eventId = '', matchId = '', team = '' } = document.getElementById('match-report-container')?.dataset ?? {};

  // Track initial page load
  trackEvent('match_report_loaded', {
    event_id: eventId,
    match_id: matchId,
    has_team_param: team !== '',
    team_param: team !== '' ? team : null
  });

  // Expose to window for use in the inline report script
  Object.assign(window, { trackEvent, trackDartEvents });
</script>

<script define:vars={{ eventId, matchId, teamParam, initialMatchSummary, tableRoundIndex: CURRENT_LEAGUE.tableRoundIndex }}>
  function normalizeStatisticsResponse(payload) {
    if (Array.isArray(payload)) return payload;
    if (payload && Array.isArray(payload.statistics)) return payload.statistics;
    return [];
  }

  // Fetch match report data
  async function fetchMatchReport() {
    const loadingEl = document.getElementById('loading');
    const errorEl = document.getElementById('error');
    const errorMessageEl = document.getElementById('error-message');
    const contentEl = document.getElementById('content');

    try {
      // Fetch report first
      const reportResponse = await fetch(`/api/match/${eventId}/${matchId}/report`);
      
      if (!reportResponse.ok) {
        throw new Error(`HTTP error! status: ${reportResponse.status}`);
      }
      
      const reportData = await reportResponse.json();
      
      const firstGame = reportData[0];
      const phaseId = firstGame?.round?.phase?.id || firstGame?.phase?.id;
      let matchSummary = initialMatchSummary;
      
      // Simpler approach: Just load statistics for each game in THIS match report
      // We already have all games in reportData!
      const gameStatsMap = new Map();
      
      for (const game of reportData) {
        if (game.id) {
          try {
            const statsResponse = await fetch(`/api/match/${eventId}/${game.id}/statistics`);
            
            if (statsResponse.ok) {
              const statsPayload = await statsResponse.json();
              const gameStats = normalizeStatisticsResponse(statsPayload);
              if (gameStats.length > 0) {
                // Store stats with the game ID as key
                const matchStats = gameStats.filter(s => s.type === 'MATCH');
                if (matchStats.length > 0) {
                  gameStatsMap.set(game.id, matchStats);
                }
              }
            }
          } catch (e) {
            console.error(`  ❌ Failed to load stats for game ${game.id}:`, e);
          }
        }
      }
      
      // Load team roster if teamParam is provided
      let teamRoster = null;
      if (teamParam) {
        try {
          const rosterResponse = await fetch(`/api/participant/${teamParam}`);
          if (rosterResponse.ok) {
            const rosterData = await rosterResponse.json();
            const rosterMembers = rosterData?.participant?.teamSeason?.teamMembers || [];
            const matchSummary = (rosterData?.matches || []).find(
              (match) => String(match?.id) === String(matchId)
            ) || null;

            teamRoster = {
              members: rosterMembers,
              match: matchSummary
            };
          }
        } catch (e) {
          console.error('Failed to load team roster:', e);
        }
      }

      matchSummary = teamRoster?.match || matchSummary;
      // The report contains individual players. Resolve the parent team match
      // independently of the optional team parameter (also for shared links).
      if (!matchSummary && phaseId) {
        try {
          const roundResponse = await fetch(`/api/round/${eventId}/${phaseId}/${tableRoundIndex}`);
          if (roundResponse.ok) {
            const roundData = await roundResponse.json();
            matchSummary = (roundData.matches || []).find(
              (match) => String(match?.id) === String(matchId)
            ) || null;
          }
        } catch (e) {
          console.error('Failed to load match pairing:', e);
        }
      }
      
      // Hide loading
      loadingEl.classList.add('hidden');
      
      // Show content
      contentEl.classList.remove('hidden');
      
      // Track successful report load
      if (window.trackEvent) {
        window.trackEvent('match_report_success', {
          event_id: String(eventId),
          match_id: String(matchId),
          games_count: reportData.length,
          has_team_roster: !!teamRoster,
          stats_games_count: gameStatsMap.size
        });
      }
      
      // Render the match report
      renderMatchReport(reportData, gameStatsMap, teamRoster, matchSummary, contentEl);
      
    } catch (error) {
      console.error('Error fetching match report:', error);
      
      // Track error
      if (window.trackEvent) {
        window.trackEvent('match_report_error', {
          event_id: String(eventId),
          match_id: String(matchId),
          error_message: error.message,
          error_type: 'fetch_error'
        });
      }
      
      // Hide loading
      loadingEl.classList.add('hidden');
      
      // Show error
      errorEl.classList.remove('hidden');
      errorEl.classList.add('flex');
      errorMessageEl.textContent = error.message;
    }
  }

  function formatDate(dateString) {
    if (!dateString) return 'N/A';
    const date = new Date(dateString);
    // 3K sends report times as league wall time without an offset, which must be
    // shown unchanged in every browser; only real instants are converted.
    const hasOffset = /(Z|[+-]\d{2}:?\d{2})$/.test(dateString);
    return date.toLocaleString('de-DE', {
      ...(hasOffset ? { timeZone: 'Europe/Berlin' } : {}),
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  function formatDuration(seconds) {
    if (!seconds) return 'N/A';
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = seconds % 60;
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')} min`;
  }

  /**
   * Calculate the 3-dart average for darts
   * 
   * @param {number} scoreTotal - Total points scored
   * @param {number} dartsTotal - Total number of darts thrown
   * @returns {string|number} - The 3-dart average as a string with 2 decimal places, or 0 if no darts thrown
   * 
   * Formula: (scoreTotal / dartsTotal) * 3
   * 
   * Example:
   * - If a player scores 180 points with 9 darts:
   *   AVG = (180 / 9) * 3 = 60.00
   * 
   * The multiplication by 3 converts the per-dart average to a 3-dart average,
   * which is the standard measurement in darts.
   */
  function calculateAverage(scoreTotal, dartsTotal) {
    if (!dartsTotal || dartsTotal === 0) return 0;
    return (scoreTotal / dartsTotal * 3).toFixed(2);
  }

  function setupStickyScoreboard() {
    const topCard = document.getElementById('top-score-card');
    const stickyBar = document.getElementById('sticky-mini-score');
    const appHeader = document.querySelector('header.sticky');

    if (!topCard || !stickyBar) return;

    const updateStickyTopOffset = () => {
      const headerHeight = appHeader ? Math.ceil(appHeader.offsetHeight || 0) : 0;
      stickyBar.style.top = `${Math.max(headerHeight, 0)}px`;
    };

    updateStickyTopOffset();
    window.addEventListener('resize', updateStickyTopOffset, { passive: true });

    if (appHeader && 'ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(updateStickyTopOffset);
      resizeObserver.observe(appHeader);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        const cardAboveViewport = entry.boundingClientRect.top < 0;
        const shouldShow = entry.intersectionRatio < 0.4 && cardAboveViewport;

        if (shouldShow) {
          stickyBar.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        } else {
          stickyBar.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        }
      },
      {
        threshold: [0, 0.15, 0.4, 1],
      }
    );

    observer.observe(topCard);
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[char]);
  }

  const SIDE_LABELS = {
    home: { label: 'Heim', badge: 'badge-brand', avg: 'bg-brand-700/10 text-brand-700 dark:bg-brand-700/25 dark:text-brand-300' },
    away: { label: 'Gast', badge: 'badge-gray', avg: 'bg-gray-100 text-gray-900 dark:bg-dark-500 dark:text-dark-50' }
  };

  function getStatusInfo(statusCd) {
    if (statusCd === 'FINISH') return { label: 'Beendet', badge: 'badge-win' };
    if (statusCd === 'ACTIVE') return { label: 'Live', badge: 'badge-brand', live: true };
    return { label: statusCd || 'Offen', badge: 'badge-gray' };
  }

  // Overall AVG is the arithmetic mean of the individual game averages
  // (not weighted by darts).
  function getOverallAverage(playerGames) {
    if (playerGames.length === 0) return '-';
    const gameAverages = playerGames
      .map(g => parseFloat(calculateAverage(g.scoreTotal, g.dartsTotal)))
      .filter(avg => !isNaN(avg)); // Filter out only invalid values, keep zero
    if (gameAverages.length === 0) return '-';
    const sumOfAverages = gameAverages.reduce((sum, avg) => sum + avg, 0);
    return (sumOfAverages / gameAverages.length).toFixed(2);
  }

  function renderTeamStats(teamName, playerStatsMap, side) {
    const style = SIDE_LABELS[side];

    // Find max number of games any player played
    let maxGames = 0;
    playerStatsMap.forEach(playerData => {
      if (playerData.stats.length > maxGames) maxGames = playerData.stats.length;
    });

    // Team average across all darts thrown
    let teamTotalDarts = 0;
    let teamTotalScore = 0;
    let teamTotalLegsWon = 0;
    playerStatsMap.forEach((playerData) => {
      playerData.stats.forEach(game => {
        teamTotalDarts += game.dartsTotal;
        teamTotalScore += game.scoreTotal;
        teamTotalLegsWon += game.legCount;
      });
    });
    const teamAvg = teamTotalDarts > 0 ? calculateAverage(teamTotalScore, teamTotalDarts) : '-';

    let gameHeaders = '';
    for (let i = 0; i < maxGames; i++) {
      gameHeaders += `<th class="divider border-t px-3 py-2.5 text-center font-bold">Spiel ${i + 1}</th>`;
    }

    let rows = '';
    playerStatsMap.forEach((playerData, playerName) => {
      const playerGames = playerData.stats;
      const totalLegsWon = playerGames.reduce((sum, g) => sum + g.legCount, 0);
      const overallAvg = getOverallAverage(playerGames);

      let gameCells = '';
      for (let i = 0; i < maxGames; i++) {
        if (i < playerGames.length) {
          const game = playerGames[i];
          const gameAvg = calculateAverage(game.scoreTotal, game.dartsTotal);
          gameCells += game.won
            ? `<td class="divider border-t px-3 py-2.5 text-center"><span class="heading inline-flex items-center gap-1.5 font-semibold" title="Spiel gewonnen">${gameAvg}<span class="h-1.5 w-1.5 rounded-full bg-win-700 dark:bg-win-400"></span></span></td>`
            : `<td class="divider dimmed border-t px-3 py-2.5 text-center">${gameAvg}</td>`;
        } else {
          gameCells += '<td class="divider dimmed border-t px-3 py-2.5 text-center">–</td>';
        }
      }

      rows += `
        <tr>
          <td class="divider heading whitespace-nowrap border-t py-2.5 pl-5 pr-3 font-medium">${escapeHtml(playerName)}</td>
          <td class="divider border-t px-3 py-2.5 text-center">${playerData.gamesPlayed}</td>
          <td class="divider border-t px-3 py-2.5 text-center">${totalLegsWon || '-'}</td>
          <td class="divider border-t px-3 py-2.5 text-center"><span class="inline-block min-w-[3.75rem] rounded-md px-2 py-0.5 font-bold ${style.avg}">${overallAvg}</span></td>
          ${gameCells}
        </tr>
      `;
    });

    return `
      <section class="paper overflow-hidden">
        <div class="paper-head">
          <div class="flex min-w-0 items-center gap-2.5">
            <h3 class="paper-title truncate">${escapeHtml(teamName)}</h3>
            <span class="${style.badge}">${style.label}</span>
          </div>
          <div class="shrink-0 text-right leading-tight">
            <p class="label">Team-Ø</p>
            <p class="heading text-lg font-bold tabular-nums">${teamAvg}</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse tabular-nums">
            <thead>
              <tr class="heading">
                <th class="divider border-t py-2.5 pl-5 pr-3 text-left font-bold">Spieler</th>
                <th class="divider border-t px-3 py-2.5 text-center font-bold">Spiele</th>
                <th class="divider border-t px-3 py-2.5 text-center font-bold">Legs Won</th>
                <th class="divider border-t px-3 py-2.5 text-center font-bold">Ø Gesamt</th>
                ${gameHeaders}
              </tr>
            </thead>
            <tbody>
              ${rows}
            </tbody>
            <tfoot>
              <tr class="heading bg-gray-50 font-bold dark:bg-dark-500/50">
                <td class="divider whitespace-nowrap border-t py-2.5 pl-5 pr-3">Team Durchschnitt</td>
                <td class="divider border-t px-3 py-2.5 text-center">${playerStatsMap.size}</td>
                <td class="divider border-t px-3 py-2.5 text-center">${teamTotalLegsWon}</td>
                <td class="divider border-t px-3 py-2.5 text-center">${teamAvg}</td>
                ${'<td class="divider border-t"></td>'.repeat(maxGames)}
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    `;
  }

  function renderMatchReport(data, gameStatsMap, teamRoster, matchSummary, container) {
    if (!data || data.length === 0) {
      container.innerHTML = '<div class="paper dimmed px-6 py-12 text-center">Keine Daten verfügbar</div>';
      return;
    }

    // Get first match for general info
    const firstMatch = data[0];
    
    // Only the parent match's display names identify teams. Individual report
    // participants' display names identify players and must never be used here.
    const homeTeams = new Set();
    const awayTeams = new Set();
    const summaryHomeTeamName = matchSummary?.participantHome?.displayName || null;
    const summaryAwayTeamName = matchSummary?.participantGuest?.displayName || null;
    
    data.forEach(match => {
      const homeName = match.participantHome?.teamSeason?.team?.name || match.participantHome?.teamSeason?.name;
      const awayName = match.participantGuest?.teamSeason?.team?.name || match.participantGuest?.teamSeason?.name;
      if (homeName) homeTeams.add(homeName);
      if (awayName) awayTeams.add(awayName);
    });
    
    const homeTeamName = summaryHomeTeamName ||
                         (homeTeams.size === 1 ? [...homeTeams][0] : 'Heimteam');
    const awayTeamName = summaryAwayTeamName ||
                         (awayTeams.size === 1 ? [...awayTeams][0] : 'Gastteam');
    
    let html = '';

    // Scoreboard - count won games (matches), not legs
    const totalGamesHome = data.filter(m => m.legsHome > m.legsAway).length;
    const totalGamesAway = data.filter(m => m.legsAway > m.legsHome).length;
    const totalLegsHome = data.reduce((sum, m) => sum + (m.legsHome || 0), 0);
    const totalLegsAway = data.reduce((sum, m) => sum + (m.legsAway || 0), 0);
    const status = getStatusInfo(firstMatch.statusCd);
    const mode = firstMatch.matchmode;
    const homeLeads = totalGamesHome > totalGamesAway;
    const awayLeads = totalGamesAway > totalGamesHome;

    const scoreChips = [
      mode?.matchmodePoints ? `${mode.matchmodePoints}` : null,
      mode?.matchmodeInCd || mode?.matchmodeOutCd ? `${mode?.matchmodeInCd || '–'} / ${mode?.matchmodeOutCd || '–'}` : null,
      mode?.legsBestOf ? `Best of ${mode.legsBestOf} Legs` : null,
      firstMatch.duration ? `Dauer ${formatDuration(firstMatch.duration)}` : null
    ].filter(Boolean);

    html += `
      <section id="top-score-card" class="paper p-5 sm:p-7">
        <div class="mb-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
          <span class="${status.badge}">${status.live ? '<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>' : ''}${escapeHtml(status.label)}</span>
          <span class="dimmed text-xs">${escapeHtml(formatDate(firstMatch.beginDate || firstMatch.datePlanned))}</span>
        </div>
        <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 sm:gap-8">
          <div class="min-w-0 text-center sm:text-right">
            <p class="label">Heim</p>
            <p class="heading mt-1 text-base leading-tight sm:text-2xl ${awayLeads ? 'font-semibold' : 'font-bold'}">${escapeHtml(homeTeamName)}</p>
            <p class="dimmed mt-1 text-xs">${totalLegsHome} Legs</p>
          </div>
          <div class="flex items-center text-5xl font-bold tabular-nums sm:text-6xl">
            <span class="${awayLeads ? 'dimmed' : 'heading'}">${totalGamesHome}</span>
            <span class="mx-2 text-3xl text-gray-500 sm:mx-3 sm:text-4xl dark:text-dark-300">:</span>
            <span class="${homeLeads ? 'dimmed' : 'heading'}">${totalGamesAway}</span>
          </div>
          <div class="min-w-0 text-center sm:text-left">
            <p class="label">Gast</p>
            <p class="heading mt-1 text-base leading-tight sm:text-2xl ${homeLeads ? 'font-semibold' : 'font-bold'}">${escapeHtml(awayTeamName)}</p>
            <p class="dimmed mt-1 text-xs">${totalLegsAway} Legs</p>
          </div>
        </div>
        ${scoreChips.length > 0 ? `
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
            ${scoreChips.map(chip => `<span class="badge-gray">${escapeHtml(chip)}</span>`).join('')}
          </div>
        ` : ''}
      </section>
    `;

    html += `
      <div id="sticky-mini-score" class="pointer-events-none fixed left-0 right-0 top-0 z-30 !mt-0 -translate-y-2 opacity-0 transition-all duration-300 lg:left-[260px]">
        <div class="divider border-b bg-white/95 backdrop-blur dark:bg-dark-600/95">
          <div class="mx-auto flex max-w-[1100px] items-center gap-3 px-4 py-2 sm:px-6 lg:px-9">
            <div class="heading min-w-0 flex-1 truncate font-semibold" title="${escapeHtml(homeTeamName)}">${escapeHtml(homeTeamName)}</div>
            <div class="shrink-0 rounded-md bg-gray-950 px-2.5 py-0.5 font-bold tabular-nums text-white dark:bg-white dark:text-gray-950">
              ${totalGamesHome}:${totalGamesAway}
            </div>
            <div class="heading min-w-0 flex-1 truncate text-right font-semibold" title="${escapeHtml(awayTeamName)}">${escapeHtml(awayTeamName)}</div>
          </div>
        </div>
      </div>
    `;

    // Group games by block
    const blockGroups = {};
    data.forEach(game => {
      const blockKey = game.matchReportBlock ? 
        `${game.matchReportBlock.blockIndex}_${game.matchReportBlock.matchTypeCd}` : 
        'other';
      
      if (!blockGroups[blockKey]) {
        blockGroups[blockKey] = {
          block: game.matchReportBlock,
          games: []
        };
      }
      blockGroups[blockKey].games.push(game);
    });

    // Render blocks
    Object.values(blockGroups).forEach((group) => {
      const block = group.block;
      const games = group.games;
      
      if (!block) return;
      
      const matchTypeLabel = block.matchTypeCd === 'EZ' ? 'Einzel' : 
                            block.matchTypeCd === 'DP' ? 'Doppel' : 
                            block.matchTypeCd;
      const blockHome = games.filter(g => g.legsHome > g.legsAway).length;
      const blockAway = games.filter(g => g.legsAway > g.legsHome).length;
      
      html += `
        <section class="paper overflow-hidden">
          <div class="paper-head">
            <div class="flex items-center gap-3">
              <span class="heading flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-gray-100 font-bold dark:bg-dark-500">${escapeHtml(block.blockIndex)}</span>
              <div class="leading-tight">
                <h3 class="heading text-base font-bold">${escapeHtml(block.numberOfMatches)}× ${escapeHtml(matchTypeLabel)}</h3>
                <p class="dimmed text-xs">Block ${escapeHtml(block.blockIndex)} · Best of ${escapeHtml(block.matchmode?.legsBestOf || 3)} Legs, ${escapeHtml(block.matchmode?.matchmodePoints || 501)}</p>
              </div>
            </div>
            <span class="heading rounded-md bg-gray-100 px-2.5 py-1 font-bold tabular-nums dark:bg-dark-500" title="Spiele gewonnen in diesem Block">${blockHome}:${blockAway}</span>
          </div>
          <!-- Games in Block -->
          <ul>
      `;
      
      games.forEach((game) => {
        const winner = game.legsHome > game.legsAway ? 'home' : game.legsAway > game.legsHome ? 'away' : 'draw';
        
        // Get player names
        const homePlayer = game.participantHome?.displayName || 'N/A';
        const awayPlayer = game.participantGuest?.displayName || 'N/A';
        
        // Get player IDs
        const homePlayerId = game.participantHome?.id;
        const awayPlayerId = game.participantGuest?.id;
        
        // Find statistics for this specific game from the map
        let homeAvg = '-';
        let awayAvg = '-';
        
        const gameStats = gameStatsMap.get(game.id);
        if (gameStats && gameStats.length > 0) {
          // Find stats for home player
          const homeStats = gameStats.find(s => 
            s.participant?.id === homePlayerId || s.displayName === homePlayer
          );
          
          // Find stats for away player
          const awayStats = gameStats.find(s => 
            s.participant?.id === awayPlayerId || s.displayName === awayPlayer
          );
          
          if (homeStats && homeStats.dartsTotal > 0) {
            homeAvg = calculateAverage(homeStats.scoreTotal, homeStats.dartsTotal);
          }
          
          if (awayStats && awayStats.dartsTotal > 0) {
            awayAvg = calculateAverage(awayStats.scoreTotal, awayStats.dartsTotal);
          }
        }
        
        // Winner is emphasized, the other side is muted
        const homeName = winner === 'home' ? 'heading font-semibold' : 'dimmed';
        const awayName = winner === 'away' ? 'heading font-semibold' : 'dimmed';
        const winDot = '<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-win-700 dark:bg-win-400" aria-label="Sieger"></span>';
        
        html += `
          <li class="divider grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 border-t px-4 py-2.5 sm:gap-5 sm:px-5">
            <div class="min-w-0 text-right">
              <div class="flex items-center justify-end gap-1.5">
                ${winner === 'home' ? winDot : ''}
                <span class="truncate ${homeName}">${escapeHtml(homePlayer)}</span>
              </div>
              <div class="dimmed text-xs tabular-nums ${homeAvg !== '-' ? '' : 'invisible'}">${homeAvg !== '-' ? 'Ø ' + homeAvg : '–'}</div>
            </div>
            <div class="flex items-center rounded-md bg-gray-100 px-3 py-1 text-base font-bold tabular-nums dark:bg-dark-500">
              <span class="${winner === 'home' ? 'heading' : 'dimmed'}">${game.legsHome || 0}</span>
              <span class="mx-1.5 text-gray-500 dark:text-dark-300">:</span>
              <span class="${winner === 'away' ? 'heading' : 'dimmed'}">${game.legsAway || 0}</span>
            </div>
            <div class="min-w-0 text-left">
              <div class="flex items-center gap-1.5">
                <span class="truncate ${awayName}">${escapeHtml(awayPlayer)}</span>
                ${winner === 'away' ? winDot : ''}
              </div>
              <div class="dimmed text-xs tabular-nums ${awayAvg !== '-' ? '' : 'invisible'}">${awayAvg !== '-' ? 'Ø ' + awayAvg : '–'}</div>
            </div>
          </li>
        `;
      });
      
      html += `
          </ul>
        </section>
      `;
    });

    // Player Statistics - Alle Spieler mit ihren Spielen am Spieltag
    html += '<h2 class="paper-title pt-2">Spieler Statistiken</h2>';

    if (gameStatsMap && gameStatsMap.size > 0) {
      // Flatten all stats from the map
      const matchStats = [];
      gameStatsMap.forEach((stats, gameId) => {
        // Add gameId to each stat for reference
        stats.forEach(stat => {
          matchStats.push({ ...stat, gameId: gameId });
        });
      });
      
      // Gruppiere Statistiken nach Spieler-ID oder Name
      const playerStatsMap = new Map();
      
      matchStats.forEach(stat => {
        // Verwende participant ID als Key, falls vorhanden
        const key = stat.participant?.id || stat.displayName;
        if (!playerStatsMap.has(key)) {
          playerStatsMap.set(key, []);
        }
        playerStatsMap.get(key).push(stat);
      });
      
      // Sammle ALLE Spieler von BEIDEN Teams
      const allHomeParticipants = new Map(); // name -> player info
      const allAwayParticipants = new Map(); // name -> player info
      
      data.forEach(game => {
        // Home team
        if (game.participantHome) {
          const name = game.participantHome.displayName || 'N/A';
          if (!allHomeParticipants.has(name)) {
            allHomeParticipants.set(name, {
              id: game.participantHome.id,
              name: name,
              games: []
            });
          }
          allHomeParticipants.get(name).games.push(game.id);
        }
        
        // Away team
        if (game.participantGuest) {
          const name = game.participantGuest.displayName || 'N/A';
          if (!allAwayParticipants.has(name)) {
            allAwayParticipants.set(name, {
              id: game.participantGuest.id,
              name: name,
              games: []
            });
          }
          allAwayParticipants.get(name).games.push(game.id);
        }
      });

      // Statistiken je Team; nur Spiele, an denen der Spieler tatsächlich
      // teilgenommen hat, fließen in seinen Gesamt-AVG ein.
      const buildPlayerStats = (participants) => {
        const result = new Map();
        participants.forEach((playerInfo, playerName) => {
          const allPlayerStats = playerStatsMap.get(playerInfo.id) || 
                                 playerStatsMap.get(playerName) || 
                                 [];
          const stats = allPlayerStats.filter(stat => playerInfo.games.includes(stat.gameId));
          result.set(playerName, {
            stats: stats,
            gamesPlayed: playerInfo.games.length,
            gameIds: playerInfo.games
          });
        });
        return result;
      };

      const homePlayerStats = buildPlayerStats(allHomeParticipants);
      const awayPlayerStats = buildPlayerStats(allAwayParticipants);

      if (homePlayerStats.size > 0) {
        html += renderTeamStats(homeTeamName, homePlayerStats, 'home');
      }
      if (awayPlayerStats.size > 0) {
        html += renderTeamStats(awayTeamName, awayPlayerStats, 'away');
      }
    } else {
      // Show message that no statistics are available
      html += `
        <div class="paper flex flex-col items-center px-6 py-12 text-center">
          <p class="heading font-semibold">Keine Statistik-Daten verfügbar</p>
          <p class="dimmed mt-1">Für dieses Match wurden keine detaillierten Statistiken aufgezeichnet.</p>
          <p class="dimmed mt-2 text-xs">Nur Matches mit Dartsscorer haben Statistik-Daten.</p>
        </div>
      `;
    }

    // Compact Additional Info
    const infoItems = [];
    
    if (firstMatch.matchReportBlock) {
      infoItems.push(`Block ${firstMatch.matchReportBlock.blockIndex}: ${firstMatch.matchReportBlock.matchTypeCd} (${firstMatch.matchReportBlock.numberOfMatches} Spiele)`);
    }
    
    if (firstMatch.phase) {
      if (firstMatch.phase.numberOfGroups) infoItems.push(`${firstMatch.phase.numberOfGroups} Gruppen`);
      if (firstMatch.phase.lineupCd) infoItems.push(`Lineup: ${firstMatch.phase.lineupCd}`);
    }
    
    if (infoItems.length > 0) {
      html += `
        <div class="flex flex-wrap gap-2">
          ${infoItems.map(item => `<span class="badge-gray">${escapeHtml(item)}</span>`).join('')}
        </div>
      `;
    }

    // Debug section
    html += `
      <details class="divider rounded-xl border border-dashed px-4 py-3">
        <summary class="dimmed cursor-pointer text-xs font-medium">Debug: Raw API Data</summary>
        <pre class="mt-3 max-h-96 overflow-auto rounded-md bg-dark-900 p-4 text-xs text-dark-50">${escapeHtml(JSON.stringify(data, null, 2))}</pre>
      </details>
    `;

    container.innerHTML = html;
    setupStickyScoreboard();
  }

  // Fetch data on page load
  fetchMatchReport();
</script>
