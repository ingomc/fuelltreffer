---
import Layout from '../../../../layouts/Layout.astro';
import LiveScoring from '../../../../components/svelte/LiveScoring.svelte';
import Icon from '../../../../components/Icon.astro';
import { CURRENT_LEAGUE } from '../../../../config/league';

const { eventId, matchId } = Astro.params;

// Get team parameter if present (for back navigation)
const teamParam = Astro.url.searchParams.get('team');
const backUrl = teamParam ? `/?team=${teamParam}` : '/';

type MatchParticipant = {
  id?: string | number;
  displayName?: string;
};

type MatchSummary = {
  id?: string | number;
  participantHome?: MatchParticipant;
  participantGuest?: MatchParticipant;
};

type ParticipantResponse = {
  matches?: MatchSummary[];
};

function getShortTeamName(participant?: MatchParticipant) {
  if (!participant) return null;

  return CURRENT_LEAGUE.teams.find((team) => team.id === String(participant.id))?.shortName
    ?? participant.displayName
    ?? null;
}

let matchTitle = 'Matchbericht';
let matchDescription = 'Details zu diesem Dart-Match.';

// Match reports contain their team information only after the report has been
// started. The participant endpoint always provides the match pairing.
if (teamParam) {
  try {
    const apiBaseUrl = process.env.TWOK_SOFTWARE_API_URL || CURRENT_LEAGUE.api.twokSoftwareBaseUrl;
    const response = await fetch(`${apiBaseUrl}/participant/${teamParam}`, {
      headers: {
        'User-Agent': 'Fuelltreffer-SSR/1.0'
      }
    });

    if (response.ok) {
      const participantData = await response.json() as ParticipantResponse;
      const match = participantData.matches?.find((candidate) => String(candidate.id) === String(matchId));
      const homeTeamName = getShortTeamName(match?.participantHome);
      const awayTeamName = getShortTeamName(match?.participantGuest);

      if (homeTeamName && awayTeamName) {
        matchTitle = `Matchbericht: ${homeTeamName} vs. ${awayTeamName}`;
        matchDescription = `Matchbericht von ${homeTeamName} gegen ${awayTeamName} in der ${CURRENT_LEAGUE.name}.`;
      }
    }
  } catch (error) {
    console.warn(`[match-report] Could not load title data for match ${matchId}:`, error);
  }
}
---

<Layout title={matchTitle} description={matchDescription}>
  <div class="mx-auto max-w-5xl px-4 pb-8 pt-6 sm:px-6 sm:pt-8 lg:px-8">
    <!-- Header with back button -->
    <div id="match-page-header" class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <a href={backUrl} class="btn-secondary h-10 w-10 p-0" aria-label="Zurück zum Dashboard" title="Zurück zum Dashboard">
          <Icon name="arrow-left" size={18} />
        </a>
        <div class="leading-tight">
          <p class="eyebrow">{CURRENT_LEAGUE.name} · Saison {CURRENT_LEAGUE.season}</p>
          <h1 class="font-display text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">Matchbericht</h1>
        </div>
      </div>
    </div>

    <div class="space-y-5">
      <LiveScoring client:load databaseId={CURRENT_LEAGUE.api.databaseId} matchId={matchId} />

      <div id="match-report-container">
        <!-- Loading state -->
        <div id="loading" class="space-y-5" aria-busy="true" aria-label="Matchbericht wird geladen">
          <div class="skeleton h-56 rounded-3xl"></div>
          <div class="skeleton h-64 rounded-2xl"></div>
          <div class="skeleton h-64 rounded-2xl"></div>
        </div>

        <!-- Error state -->
        <div id="error" class="card hidden flex-col items-center px-6 py-14 text-center" role="alert">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-loss-50 text-loss-500 dark:bg-loss-500/10">
            <Icon name="alert" size={22} />
          </span>
          <p class="mt-3 font-semibold text-zinc-900 dark:text-white">Fehler beim Laden des Match Reports</p>
          <p id="error-message" class="mt-1 text-sm text-zinc-500 dark:text-zinc-400"></p>
          <a href={backUrl} class="btn-secondary mt-5">
            <Icon name="arrow-left" size={15} /> Zurück zum Dashboard
          </a>
        </div>

        <!-- Content -->
        <div id="content" class="hidden space-y-5"></div>
      </div>
    </div>
  </div>
</Layout>

<script type="module">
  import { trackEvent, trackDartEvents } from '/src/utils/umami.js';
  
  // Get variables from Astro
  const eventId = '{eventId}';
  const matchId = '{matchId}';
  const teamParam = '{teamParam}';
  
  // Track initial page load
  trackEvent('match_report_loaded', {
    event_id: String(eventId),
    match_id: String(matchId),
    has_team_param: !!teamParam && teamParam !== '',
    team_param: teamParam && teamParam !== '' ? teamParam : null
  });

  // Expose to window for use in other parts of the script
  window.trackEvent = trackEvent;
  window.trackDartEvents = trackDartEvents;
</script>

<script define:vars={{ eventId, matchId, teamParam }}>
  function normalizeStatisticsResponse(payload) {
    if (Array.isArray(payload)) return payload;
    if (payload && Array.isArray(payload.statistics)) return payload.statistics;
    return [];
  }

  // Fetch match report data
  async function fetchMatchReport() {
    const loadingEl = document.getElementById('loading');
    const errorEl = document.getElementById('error');
    const errorMessageEl = document.getElementById('error-message');
    const contentEl = document.getElementById('content');

    try {
      // Fetch report first
      const reportResponse = await fetch(`/api/match/${eventId}/${matchId}/report`);
      
      if (!reportResponse.ok) {
        throw new Error(`HTTP error! status: ${reportResponse.status}`);
      }
      
      const reportData = await reportResponse.json();
      
      const firstGame = reportData[0];
      const phaseId = firstGame.round?.phase?.id || firstGame.phase?.id;
      const roundIndex = firstGame.round?.roundIndex !== undefined ? firstGame.round.roundIndex : firstGame.roundNr;
      
      // Simpler approach: Just load statistics for each game in THIS match report
      // We already have all games in reportData!
      const gameStatsMap = new Map();
      
      for (const game of reportData) {
        if (game.id) {
          try {
            const statsResponse = await fetch(`/api/match/${eventId}/${game.id}/statistics`);
            
            if (statsResponse.ok) {
              const statsPayload = await statsResponse.json();
              const gameStats = normalizeStatisticsResponse(statsPayload);
              if (gameStats.length > 0) {
                // Store stats with the game ID as key
                const matchStats = gameStats.filter(s => s.type === 'MATCH');
                if (matchStats.length > 0) {
                  gameStatsMap.set(game.id, matchStats);
                }
              }
            }
          } catch (e) {
            console.error(`  ❌ Failed to load stats for game ${game.id}:`, e);
          }
        }
      }
      
      // Load team roster if teamParam is provided
      let teamRoster = null;
      if (teamParam) {
        try {
          const rosterResponse = await fetch(`/api/participant/${teamParam}`);
          if (rosterResponse.ok) {
            const rosterData = await rosterResponse.json();
            const rosterMembers = rosterData?.participant?.teamSeason?.teamMembers || [];
            const matchSummary = (rosterData?.matches || []).find(
              (match) => String(match?.id) === String(matchId)
            ) || null;

            teamRoster = {
              members: rosterMembers,
              match: matchSummary
            };
          }
        } catch (e) {
          console.error('Failed to load team roster:', e);
        }
      }
      
      // Hide loading
      loadingEl.classList.add('hidden');
      
      // Show content
      contentEl.classList.remove('hidden');
      
      // Track successful report load
      if (window.trackEvent) {
        window.trackEvent('match_report_success', {
          event_id: String(eventId),
          match_id: String(matchId),
          games_count: reportData.length,
          has_team_roster: !!teamRoster,
          stats_games_count: gameStatsMap.size
        });
      }
      
      // Render the match report
      renderMatchReport(reportData, gameStatsMap, teamRoster, contentEl);
      
    } catch (error) {
      console.error('Error fetching match report:', error);
      
      // Track error
      if (window.trackEvent) {
        window.trackEvent('match_report_error', {
          event_id: String(eventId),
          match_id: String(matchId),
          error_message: error.message,
          error_type: 'fetch_error'
        });
      }
      
      // Hide loading
      loadingEl.classList.add('hidden');
      
      // Show error
      errorEl.classList.remove('hidden');
      errorEl.classList.add('flex');
      errorMessageEl.textContent = error.message;
    }
  }

  function formatDate(dateString) {
    if (!dateString) return 'N/A';
    const date = new Date(dateString);
    return date.toLocaleString('de-DE', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  function formatDuration(seconds) {
    if (!seconds) return 'N/A';
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = seconds % 60;
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')} min`;
  }

  /**
   * Calculate the 3-dart average for darts
   * 
   * @param {number} scoreTotal - Total points scored
   * @param {number} dartsTotal - Total number of darts thrown
   * @returns {string|number} - The 3-dart average as a string with 2 decimal places, or 0 if no darts thrown
   * 
   * Formula: (scoreTotal / dartsTotal) * 3
   * 
   * Example:
   * - If a player scores 180 points with 9 darts:
   *   AVG = (180 / 9) * 3 = 60.00
   * 
   * The multiplication by 3 converts the per-dart average to a 3-dart average,
   * which is the standard measurement in darts.
   */
  function calculateAverage(scoreTotal, dartsTotal) {
    if (!dartsTotal || dartsTotal === 0) return 0;
    return (scoreTotal / dartsTotal * 3).toFixed(2);
  }

  function setupStickyScoreboard() {
    const topCard = document.getElementById('top-score-card');
    const stickyBar = document.getElementById('sticky-mini-score');
    const appHeader = document.querySelector('header.sticky');

    if (!topCard || !stickyBar) return;

    const updateStickyTopOffset = () => {
      const headerHeight = appHeader ? Math.ceil(appHeader.offsetHeight || 0) : 0;
      stickyBar.style.top = `${Math.max(headerHeight, 0)}px`;
    };

    updateStickyTopOffset();
    window.addEventListener('resize', updateStickyTopOffset, { passive: true });

    if (appHeader && 'ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(updateStickyTopOffset);
      resizeObserver.observe(appHeader);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        const cardAboveViewport = entry.boundingClientRect.top < 0;
        const shouldShow = entry.intersectionRatio < 0.4 && cardAboveViewport;

        if (shouldShow) {
          stickyBar.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        } else {
          stickyBar.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        }
      },
      {
        threshold: [0, 0.15, 0.4, 1],
      }
    );

    observer.observe(topCard);
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[char]);
  }

  const SIDE_STYLES = {
    home: {
      label: 'Heim',
      dot: 'bg-brand-500',
      chip: 'border-brand-200 bg-brand-50 text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-300',
      avg: 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-200',
      footer: 'bg-brand-50/60 dark:bg-brand-500/[0.07]'
    },
    away: {
      label: 'Gast',
      dot: 'bg-amber-500',
      chip: 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300',
      avg: 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-200',
      footer: 'bg-amber-50/60 dark:bg-amber-500/[0.07]'
    }
  };

  function getStatusInfo(statusCd) {
    if (statusCd === 'FINISH') return { label: 'Beendet', classes: 'bg-emerald-400/15 text-emerald-300 ring-emerald-400/30' };
    if (statusCd === 'ACTIVE') return { label: 'Live', classes: 'bg-rose-500 text-white ring-rose-400/50', live: true };
    return { label: statusCd || 'Offen', classes: 'bg-white/10 text-white/80 ring-white/15' };
  }

  // Overall AVG is the arithmetic mean of the individual game averages
  // (not weighted by darts).
  function getOverallAverage(playerGames) {
    if (playerGames.length === 0) return '-';
    const gameAverages = playerGames
      .map(g => parseFloat(calculateAverage(g.scoreTotal, g.dartsTotal)))
      .filter(avg => !isNaN(avg)); // Filter out only invalid values, keep zero
    if (gameAverages.length === 0) return '-';
    const sumOfAverages = gameAverages.reduce((sum, avg) => sum + avg, 0);
    return (sumOfAverages / gameAverages.length).toFixed(2);
  }

  function renderTeamStats(teamName, playerStatsMap, side) {
    const style = SIDE_STYLES[side];

    // Find max number of games any player played
    let maxGames = 0;
    playerStatsMap.forEach(playerData => {
      if (playerData.stats.length > maxGames) maxGames = playerData.stats.length;
    });

    // Team average across all darts thrown
    let teamTotalDarts = 0;
    let teamTotalScore = 0;
    let teamTotalLegsWon = 0;
    playerStatsMap.forEach((playerData) => {
      playerData.stats.forEach(game => {
        teamTotalDarts += game.dartsTotal;
        teamTotalScore += game.scoreTotal;
        teamTotalLegsWon += game.legCount;
      });
    });
    const teamAvg = teamTotalDarts > 0 ? calculateAverage(teamTotalScore, teamTotalDarts) : '-';

    let gameHeaders = '';
    for (let i = 0; i < maxGames; i++) {
      gameHeaders += `<th class="px-3 py-2.5 text-center font-semibold">Spiel ${i + 1}</th>`;
    }

    let rows = '';
    playerStatsMap.forEach((playerData, playerName) => {
      const playerGames = playerData.stats;
      const totalLegsWon = playerGames.reduce((sum, g) => sum + g.legCount, 0);
      const overallAvg = getOverallAverage(playerGames);

      let gameCells = '';
      for (let i = 0; i < maxGames; i++) {
        if (i < playerGames.length) {
          const game = playerGames[i];
          const gameAvg = calculateAverage(game.scoreTotal, game.dartsTotal);
          gameCells += game.won
            ? `<td class="px-3 py-2.5 text-center"><span class="inline-flex items-center gap-1 font-semibold text-zinc-900 dark:text-white" title="Spiel gewonnen">${gameAvg}<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span></span></td>`
            : `<td class="px-3 py-2.5 text-center text-zinc-500 dark:text-zinc-400">${gameAvg}</td>`;
        } else {
          gameCells += '<td class="px-3 py-2.5 text-center text-zinc-300 dark:text-zinc-600">–</td>';
        }
      }

      rows += `
        <tr class="transition-colors hover:bg-zinc-50 dark:hover:bg-white/[0.03]">
          <td class="whitespace-nowrap px-4 py-2.5 font-medium text-zinc-900 sm:px-5 dark:text-zinc-100">${escapeHtml(playerName)}</td>
          <td class="px-3 py-2.5 text-center text-zinc-600 dark:text-zinc-300">${playerData.gamesPlayed}</td>
          <td class="px-3 py-2.5 text-center text-zinc-600 dark:text-zinc-300">${totalLegsWon || '-'}</td>
          <td class="px-3 py-2.5 text-center"><span class="inline-block min-w-[3.75rem] rounded-lg px-2 py-1 font-display font-bold ${style.avg}">${overallAvg}</span></td>
          ${gameCells}
        </tr>
      `;
    });

    return `
      <div class="card overflow-hidden">
        <div class="card-header">
          <div class="flex min-w-0 items-center gap-2.5">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full ${style.dot}"></span>
            <p class="truncate font-semibold text-zinc-900 dark:text-white">${escapeHtml(teamName)}</p>
            <span class="chip ${style.chip}">${style.label}</span>
          </div>
          <div class="shrink-0 text-right leading-tight">
            <p class="eyebrow">Team-Ø</p>
            <p class="font-display text-xl font-bold tabular-nums text-zinc-900 dark:text-white">${teamAvg}</p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm tabular-nums">
            <thead>
              <tr class="text-[11px] uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                <th class="px-4 py-2.5 text-left font-semibold sm:px-5">Spieler</th>
                <th class="px-3 py-2.5 text-center font-semibold">Spiele</th>
                <th class="px-3 py-2.5 text-center font-semibold">Legs Won</th>
                <th class="px-3 py-2.5 text-center font-semibold">Ø Gesamt</th>
                ${gameHeaders}
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 border-t border-zinc-100 dark:divide-white/[0.05] dark:border-white/[0.05]">
              ${rows}
            </tbody>
            <tfoot>
              <tr class="border-t border-zinc-200 font-semibold dark:border-white/10 ${style.footer}">
                <td class="whitespace-nowrap px-4 py-3 text-zinc-900 sm:px-5 dark:text-white">Team Durchschnitt</td>
                <td class="px-3 py-3 text-center text-zinc-700 dark:text-zinc-200">${playerStatsMap.size}</td>
                <td class="px-3 py-3 text-center text-zinc-700 dark:text-zinc-200">${teamTotalLegsWon}</td>
                <td class="px-3 py-3 text-center font-display text-base font-bold text-zinc-900 dark:text-white">${teamAvg}</td>
                ${'<td></td>'.repeat(maxGames)}
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    `;
  }

  function renderMatchReport(data, gameStatsMap, teamRoster, container) {
    if (!data || data.length === 0) {
      container.innerHTML = '<div class="card px-6 py-14 text-center text-sm text-zinc-500 dark:text-zinc-400">Keine Daten verfügbar</div>';
      return;
    }

    // Get first match for general info
    const firstMatch = data[0];
    
    // Try to find team names by looking at all participants
    // Group by home/away and collect unique team names
    const homeTeams = new Set();
    const awayTeams = new Set();
    const summaryHomeTeamName = teamRoster?.match?.participantHome?.displayName || null;
    const summaryAwayTeamName = teamRoster?.match?.participantGuest?.displayName || null;
    
    data.forEach(match => {
      const homeName = match.participantHome?.teamSeason?.team?.name || match.participantHome?.displayName;
      const awayName = match.participantGuest?.teamSeason?.team?.name || match.participantGuest?.displayName;
      if (homeName) homeTeams.add(homeName);
      if (awayName) awayTeams.add(awayName);
    });
    
    const homeTeamName = summaryHomeTeamName ||
                         (homeTeams.size === 1 ? [...homeTeams][0] : 
                         firstMatch.participantHome?.teamSeason?.team?.name || firstMatch.participantHome?.displayName || 
                         'Heimteam');
    const awayTeamName = summaryAwayTeamName ||
                         (awayTeams.size === 1 ? [...awayTeams][0] : 
                         firstMatch.participantGuest?.teamSeason?.team?.name || firstMatch.participantGuest?.displayName || 
                         'Gastteam');
    
    let html = '';

    // Scoreboard - count won games (matches), not legs
    const totalGamesHome = data.filter(m => m.legsHome > m.legsAway).length;
    const totalGamesAway = data.filter(m => m.legsAway > m.legsHome).length;
    const totalLegsHome = data.reduce((sum, m) => sum + (m.legsHome || 0), 0);
    const totalLegsAway = data.reduce((sum, m) => sum + (m.legsAway || 0), 0);
    const status = getStatusInfo(firstMatch.statusCd);
    const mode = firstMatch.matchmode;
    const homeLeads = totalGamesHome > totalGamesAway;
    const awayLeads = totalGamesAway > totalGamesHome;

    const scoreChips = [
      mode?.matchmodePoints ? `${mode.matchmodePoints}` : null,
      mode?.matchmodeInCd || mode?.matchmodeOutCd ? `${mode?.matchmodeInCd || '–'} / ${mode?.matchmodeOutCd || '–'}` : null,
      mode?.legsBestOf ? `Best of ${mode.legsBestOf} Legs` : null,
      firstMatch.duration ? `⏱ ${formatDuration(firstMatch.duration)}` : null
    ].filter(Boolean);

    html += `
      <section id="top-score-card" class="relative overflow-hidden rounded-3xl bg-zinc-950 text-white shadow-xl ring-1 ring-black/5 dark:ring-white/10">
        <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(60% 90% at 0% 0%, rgb(99 102 241 / 0.45), transparent 60%), radial-gradient(60% 90% at 100% 100%, rgb(245 158 11 / 0.28), transparent 60%);"></div>
        <div class="pointer-events-none absolute inset-0 opacity-30" style="background-image: radial-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1px); background-size: 18px 18px;"></div>
        <div class="relative px-4 py-6 sm:px-10 sm:py-9">
          <div class="mb-6 flex flex-wrap items-center justify-center gap-2 text-xs">
            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-semibold ring-1 ring-inset ${status.classes}">
              ${status.live ? '<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-white"></span>' : ''}${escapeHtml(status.label)}
            </span>
            <span class="rounded-full bg-white/10 px-2.5 py-1 font-medium text-white/80 ring-1 ring-inset ring-white/15">
              ${escapeHtml(formatDate(firstMatch.beginDate || firstMatch.datePlanned).split(',').slice(0, 2).join(','))}
            </span>
          </div>

          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 sm:gap-8">
            <div class="min-w-0 text-center sm:text-right">
              <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-brand-300">Heim</p>
              <p class="mt-1 font-display text-sm font-semibold leading-tight sm:text-2xl ${homeLeads ? 'text-white' : 'text-white/75'}">${escapeHtml(homeTeamName)}</p>
              <p class="mt-1 text-xs text-white/50">${totalLegsHome} Legs</p>
            </div>
            <div class="flex items-center font-display text-5xl font-bold tabular-nums tracking-tight sm:text-7xl">
              <span class="${awayLeads ? 'text-white/40' : 'text-white'}">${totalGamesHome}</span>
              <span class="mx-1.5 pb-1 text-3xl text-white/25 sm:mx-3 sm:text-5xl">:</span>
              <span class="${homeLeads ? 'text-white/40' : 'text-white'}">${totalGamesAway}</span>
            </div>
            <div class="min-w-0 text-center sm:text-left">
              <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-amber-300">Gast</p>
              <p class="mt-1 font-display text-sm font-semibold leading-tight sm:text-2xl ${awayLeads ? 'text-white' : 'text-white/75'}">${escapeHtml(awayTeamName)}</p>
              <p class="mt-1 text-xs text-white/50">${totalLegsAway} Legs</p>
            </div>
          </div>

          ${scoreChips.length > 0 ? `
            <div class="mt-7 flex flex-wrap items-center justify-center gap-2">
              ${scoreChips.map(chip => `<span class="rounded-lg bg-white/[0.07] px-2.5 py-1 text-xs font-medium text-white/70 ring-1 ring-inset ring-white/10">${escapeHtml(chip)}</span>`).join('')}
            </div>
          ` : ''}
        </div>
      </section>
    `;

    html += `
      <div id="sticky-mini-score" class="pointer-events-none fixed left-0 right-0 top-0 z-40 !mt-0 -translate-y-2 opacity-0 transition-all duration-300">
        <div class="border-b border-zinc-200/70 bg-white/85 backdrop-blur-xl dark:border-white/[0.06] dark:bg-zinc-950/85">
          <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-2 text-sm sm:px-6 lg:px-8">
            <span class="h-2 w-2 shrink-0 rounded-full bg-brand-500"></span>
            <div class="min-w-0 flex-1 truncate font-semibold text-zinc-900 dark:text-white" title="${escapeHtml(homeTeamName)}">${escapeHtml(homeTeamName)}</div>
            <div class="shrink-0 rounded-lg bg-zinc-900 px-2.5 py-0.5 font-display text-sm font-bold tabular-nums text-white dark:bg-white dark:text-zinc-900">
              ${totalGamesHome}:${totalGamesAway}
            </div>
            <div class="min-w-0 flex-1 truncate text-right font-semibold text-zinc-900 dark:text-white" title="${escapeHtml(awayTeamName)}">${escapeHtml(awayTeamName)}</div>
            <span class="h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
          </div>
        </div>
      </div>
    `;

    // Group games by block
    const blockGroups = {};
    data.forEach(game => {
      const blockKey = game.matchReportBlock ? 
        `${game.matchReportBlock.blockIndex}_${game.matchReportBlock.matchTypeCd}` : 
        'other';
      
      if (!blockGroups[blockKey]) {
        blockGroups[blockKey] = {
          block: game.matchReportBlock,
          games: []
        };
      }
      blockGroups[blockKey].games.push(game);
    });

    // Render blocks
    Object.values(blockGroups).forEach((group) => {
      const block = group.block;
      const games = group.games;
      
      if (!block) return;
      
      const matchTypeLabel = block.matchTypeCd === 'EZ' ? 'Einzel' : 
                            block.matchTypeCd === 'DP' ? 'Doppel' : 
                            block.matchTypeCd;
      const blockHome = games.filter(g => g.legsHome > g.legsAway).length;
      const blockAway = games.filter(g => g.legsAway > g.legsHome).length;
      
      html += `
        <section class="card overflow-hidden">
          <div class="card-header">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-zinc-900 font-display text-sm font-bold text-white dark:bg-white dark:text-zinc-900">${escapeHtml(block.blockIndex)}</span>
              <div class="leading-tight">
                <p class="font-semibold text-zinc-900 dark:text-white">${escapeHtml(block.numberOfMatches)}× ${escapeHtml(matchTypeLabel)}</p>
                <p class="text-xs text-zinc-500 dark:text-zinc-400">Block ${escapeHtml(block.blockIndex)} · Best of ${escapeHtml(block.matchmode?.legsBestOf || 3)} Legs, ${escapeHtml(block.matchmode?.matchmodePoints || 501)}</p>
              </div>
            </div>
            <span class="rounded-lg bg-zinc-100 px-2.5 py-1 font-display text-sm font-bold tabular-nums text-zinc-900 dark:bg-white/[0.06] dark:text-white" title="Spiele gewonnen in diesem Block">${blockHome}:${blockAway}</span>
          </div>
          <ul class="divide-y divide-zinc-100 dark:divide-white/[0.05]">
      `;
      
      games.forEach((game) => {
        const winner = game.legsHome > game.legsAway ? 'home' : game.legsAway > game.legsHome ? 'away' : 'draw';
        
        // Get player names
        const homePlayer = game.participantHome?.displayName || 'N/A';
        const awayPlayer = game.participantGuest?.displayName || 'N/A';
        
        // Get player IDs
        const homePlayerId = game.participantHome?.id;
        const awayPlayerId = game.participantGuest?.id;
        
        // Find statistics for this specific game from the map
        let homeAvg = '-';
        let awayAvg = '-';
        
        const gameStats = gameStatsMap.get(game.id);
        if (gameStats && gameStats.length > 0) {
          // Find stats for home player
          const homeStats = gameStats.find(s => 
            s.participant?.id === homePlayerId || s.displayName === homePlayer
          );
          
          // Find stats for away player
          const awayStats = gameStats.find(s => 
            s.participant?.id === awayPlayerId || s.displayName === awayPlayer
          );
          
          if (homeStats && homeStats.dartsTotal > 0) {
            homeAvg = calculateAverage(homeStats.scoreTotal, homeStats.dartsTotal);
          }
          
          if (awayStats && awayStats.dartsTotal > 0) {
            awayAvg = calculateAverage(awayStats.scoreTotal, awayStats.dartsTotal);
          }
        }
        
        // Winner is emphasized, the other side is muted
        const homeName = winner === 'home' ? 'font-semibold text-zinc-900 dark:text-white' : 'text-zinc-500 dark:text-zinc-400';
        const awayName = winner === 'away' ? 'font-semibold text-zinc-900 dark:text-white' : 'text-zinc-500 dark:text-zinc-400';
        const homeScore = winner === 'home' ? 'text-zinc-900 dark:text-white' : 'text-zinc-400 dark:text-zinc-500';
        const awayScore = winner === 'away' ? 'text-zinc-900 dark:text-white' : 'text-zinc-400 dark:text-zinc-500';
        
        html += `
          <li class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 px-3 py-3 transition-colors hover:bg-zinc-50 sm:gap-5 sm:px-5 dark:hover:bg-white/[0.03]">
            <div class="min-w-0 text-right">
              <div class="flex items-center justify-end gap-1.5">
                ${winner === 'home' ? '<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-label="Sieger"></span>' : ''}
                <span class="truncate text-sm ${homeName}">${escapeHtml(homePlayer)}</span>
              </div>
              <div class="mt-0.5 text-xs tabular-nums ${homeAvg !== '-' ? 'text-brand-600 dark:text-brand-300' : 'text-transparent'}">${homeAvg !== '-' ? 'Ø ' + homeAvg : '–'}</div>
            </div>
            <div class="flex items-center rounded-xl bg-zinc-100 px-3 py-1.5 font-display text-lg font-bold tabular-nums dark:bg-white/[0.06]">
              <span class="${homeScore}">${game.legsHome || 0}</span>
              <span class="mx-1.5 text-zinc-300 dark:text-zinc-600">:</span>
              <span class="${awayScore}">${game.legsAway || 0}</span>
            </div>
            <div class="min-w-0 text-left">
              <div class="flex items-center gap-1.5">
                <span class="truncate text-sm ${awayName}">${escapeHtml(awayPlayer)}</span>
                ${winner === 'away' ? '<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-label="Sieger"></span>' : ''}
              </div>
              <div class="mt-0.5 text-xs tabular-nums ${awayAvg !== '-' ? 'text-amber-600 dark:text-amber-300' : 'text-transparent'}">${awayAvg !== '-' ? 'Ø ' + awayAvg : '–'}</div>
            </div>
          </li>
        `;
      });
      
      html += `
          </ul>
        </section>
      `;
    });

    // Player Statistics - Alle Spieler mit ihren Spielen am Spieltag
    html += `
      <div class="flex items-center gap-2 px-1 pt-3">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-zinc-400" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/></svg>
        <h2 class="eyebrow">Spieler Statistiken</h2>
      </div>
    `;

    if (gameStatsMap && gameStatsMap.size > 0) {
      // Flatten all stats from the map
      const matchStats = [];
      gameStatsMap.forEach((stats, gameId) => {
        // Add gameId to each stat for reference
        stats.forEach(stat => {
          matchStats.push({ ...stat, gameId: gameId });
        });
      });
      
      // Gruppiere Statistiken nach Spieler-ID oder Name
      const playerStatsMap = new Map();
      
      matchStats.forEach(stat => {
        // Verwende participant ID als Key, falls vorhanden
        const key = stat.participant?.id || stat.displayName;
        if (!playerStatsMap.has(key)) {
          playerStatsMap.set(key, []);
        }
        playerStatsMap.get(key).push(stat);
      });
      
      // Sammle ALLE Spieler von BEIDEN Teams
      const allHomeParticipants = new Map(); // name -> player info
      const allAwayParticipants = new Map(); // name -> player info
      
      data.forEach(game => {
        // Home team
        if (game.participantHome) {
          const name = game.participantHome.displayName || 'N/A';
          if (!allHomeParticipants.has(name)) {
            allHomeParticipants.set(name, {
              id: game.participantHome.id,
              name: name,
              games: []
            });
          }
          allHomeParticipants.get(name).games.push(game.id);
        }
        
        // Away team
        if (game.participantGuest) {
          const name = game.participantGuest.displayName || 'N/A';
          if (!allAwayParticipants.has(name)) {
            allAwayParticipants.set(name, {
              id: game.participantGuest.id,
              name: name,
              games: []
            });
          }
          allAwayParticipants.get(name).games.push(game.id);
        }
      });

      // Statistiken je Team; nur Spiele, an denen der Spieler tatsächlich
      // teilgenommen hat, fließen in seinen Gesamt-AVG ein.
      const buildPlayerStats = (participants) => {
        const result = new Map();
        participants.forEach((playerInfo, playerName) => {
          const allPlayerStats = playerStatsMap.get(playerInfo.id) || 
                                 playerStatsMap.get(playerName) || 
                                 [];
          const stats = allPlayerStats.filter(stat => playerInfo.games.includes(stat.gameId));
          result.set(playerName, {
            stats: stats,
            gamesPlayed: playerInfo.games.length,
            gameIds: playerInfo.games
          });
        });
        return result;
      };

      const homePlayerStats = buildPlayerStats(allHomeParticipants);
      const awayPlayerStats = buildPlayerStats(allAwayParticipants);

      if (homePlayerStats.size > 0) {
        html += renderTeamStats(homeTeamName, homePlayerStats, 'home');
      }
      if (awayPlayerStats.size > 0) {
        html += renderTeamStats(awayTeamName, awayPlayerStats, 'away');
      }
    } else {
      // Show message that no statistics are available
      html += `
        <div class="card flex flex-col items-center px-6 py-12 text-center">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-zinc-100 text-zinc-400 dark:bg-white/5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/></svg>
          </span>
          <p class="mt-3 font-semibold text-zinc-900 dark:text-white">Keine Statistik-Daten verfügbar</p>
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Für dieses Match wurden keine detaillierten Statistiken aufgezeichnet.</p>
          <p class="mt-2 text-xs text-zinc-400">Nur Matches mit Dartsscorer haben Statistik-Daten.</p>
        </div>
      `;
    }

    // Compact Additional Info
    const infoItems = [];
    
    if (firstMatch.matchReportBlock) {
      infoItems.push(`Block ${firstMatch.matchReportBlock.blockIndex}: ${firstMatch.matchReportBlock.matchTypeCd} (${firstMatch.matchReportBlock.numberOfMatches} Spiele)`);
    }
    
    if (firstMatch.phase) {
      if (firstMatch.phase.numberOfGroups) infoItems.push(`${firstMatch.phase.numberOfGroups} Gruppen`);
      if (firstMatch.phase.lineupCd) infoItems.push(`Lineup: ${firstMatch.phase.lineupCd}`);
    }
    
    if (infoItems.length > 0) {
      html += `
        <div class="flex flex-wrap gap-2">
          ${infoItems.map(item => `<span class="chip">${escapeHtml(item)}</span>`).join('')}
        </div>
      `;
    }

    // Debug section
    html += `
      <details class="group rounded-2xl border border-dashed border-zinc-200 px-4 py-3 dark:border-white/10">
        <summary class="cursor-pointer text-xs font-medium text-zinc-500 dark:text-zinc-400">Debug: Raw API Data</summary>
        <pre class="mt-3 max-h-96 overflow-auto rounded-xl bg-zinc-950 p-4 text-xs text-zinc-300">${escapeHtml(JSON.stringify(data, null, 2))}</pre>
      </details>
    `;

    container.innerHTML = html;
    setupStickyScoreboard();
  }

  // Fetch data on page load
  fetchMatchReport();
</script>
