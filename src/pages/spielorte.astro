---
import Layout from '../layouts/Layout.astro';
import { CURRENT_LEAGUE, CURRENT_LEAGUE_TITLE } from '../config/league';
import { VENUES_SEO } from '../config/seo';
import Icon from '../components/Icon.astro';
import { groupVenues, loadVenues } from '../lib/venue-data';
import snapshot from '../data/venues.snapshot.json';
import locations from '../data/venue-locations.json';

export const prerender = true;

const entries = await loadVenues(CURRENT_LEAGUE.teams, {
  baseUrl: import.meta.env.TWOK_SOFTWARE_API_URL || CURRENT_LEAGUE.api.twokSoftwareBaseUrl,
  snapshot,
  locations,
});
const groups = groupVenues(entries);
// Only the data needed for markers is embedded in the static HTML.
const mapData = JSON.stringify(groups).replace(/</g, '\\u003c');
---

<Layout
  {...VENUES_SEO}
  showTeamSelector={false}
>
  <div class="mx-auto max-w-7xl px-4 pb-8 pt-8 sm:px-6 sm:pt-10 lg:px-8">
    <a href="/" class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">
      <Icon name="arrow-left" size={15} /> Zum Dashboard
    </a>
    <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
      <div>
        <span class="chip mb-3 border-brand-200 bg-brand-50 text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-300">
          <Icon name="trophy" size={12} /> {CURRENT_LEAGUE_TITLE}
        </span>
        <h1 class="font-display text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">Unsere Spielorte</h1>
        <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">Von der nächsten Auswärtsfahrt bis zum Heimspiel: Hier findest du die Spielstätten aller Liga-Teams.</p>
      </div>
      <div class="flex gap-3">
        <div class="card px-4 py-3">
          <p class="num text-2xl font-bold text-zinc-900 dark:text-white">{entries.length}</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">Teams</p>
        </div>
        <div class="card px-4 py-3">
          <p class="num text-2xl font-bold text-zinc-900 dark:text-white">{groups.length}</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">Spielorte auf der Karte</p>
        </div>
      </div>
    </div>

    <section aria-label="Karte der Spielorte" class="card mb-10 overflow-hidden">
      <div class="card-header flex-wrap">
        <p class="flex items-center gap-2 text-sm text-zinc-600 dark:text-zinc-300">
          <Icon name="map-pin" size={15} class="text-brand-500" />
          Wähle einen Marker oder einen Verein aus der Liste.
        </p>
        <button id="show-all-venues" type="button" hidden class="btn-ghost px-3 py-1.5 text-brand-600 dark:text-brand-400">Alle Spielorte zeigen</button>
      </div>
      <div id="venue-map" class="venue-map" role="region" aria-label="Interaktive Karte der Spielstätten" tabindex="0">
        <p class="p-6 text-sm text-zinc-600 dark:text-zinc-300">Die Spielorte findest du auch in der Liste unterhalb der Karte.</p>
      </div>
      <p id="venue-map-status" role="status" class="border-t border-zinc-100 px-4 py-3 text-xs text-zinc-500 sm:px-5 dark:border-white/[0.06] dark:text-zinc-400">Karte wird geladen. Alle Adressen und Kartenlinks sind bereits unten verfügbar.</p>
      <noscript><p class="px-4 pb-3 text-sm text-zinc-600 dark:text-zinc-300">Aktiviere JavaScript für die interaktive Karte. Die Vereinsliste und OpenStreetMap-Links funktionieren auch ohne JavaScript.</p></noscript>
    </section>

    <section aria-labelledby="venue-list-title">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <h2 id="venue-list-title" class="font-display text-xl font-semibold tracking-tight text-zinc-900 dark:text-white">Alle Vereine</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">Alphabetisch nach Team</p>
      </div>
      <ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {entries.map(entry => (
          <li id={`team-${entry.teamId}`} class="venue-card card flex flex-col p-5 transition-all">
            <div class="mb-3 flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-300">
                <Icon name="map-pin" size={18} />
              </span>
              <h3 class="pt-2 font-semibold leading-tight text-zinc-900 dark:text-white">{entry.teamName}</h3>
            </div>
            {entry.venue ? (
              <div class="mb-4 flex-1 text-sm">
                <p class="font-medium text-zinc-700 dark:text-zinc-200">{entry.venue.name || 'Spielstätte'}</p>
                <address class="mt-1 not-italic text-zinc-500 dark:text-zinc-400">
                  {entry.venue.street && <>{entry.venue.street}<br /></>}
                  {[entry.venue.postalCode, entry.venue.city].filter(Boolean).join(' ')}
                </address>
                {!entry.location && <p class="mt-2 text-xs text-zinc-400">Dieser Spielort ist noch nicht auf der Karte markiert.</p>}
              </div>
            ) : <p class="mb-4 flex-1 text-sm text-zinc-500 dark:text-zinc-400">Für dieses Team ist noch kein Spielort hinterlegt.</p>}
            <div class="flex flex-wrap items-center gap-2">
              {entry.location && <button type="button" data-show-venue={entry.teamId} hidden class="btn-primary">Auf Karte zeigen</button>}
              {entry.osmUrl && <a href={entry.osmUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">OpenStreetMap <Icon name="external" size={13} /></a>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script is:inline id="venue-map-data" type="application/json" set:html={mapData} />
</Layout>

<script>
  import '../scripts/venue-map';
</script>

<style>
  .venue-map { position: relative; z-index: 0; height: clamp(320px, 55vh, 560px); background: #e4e4e7; }
  :global(.dark) .venue-map { background: #18181b; }
  :global(.dark) .venue-map :global(.leaflet-tile-pane) { filter: brightness(0.75) contrast(1.1) saturate(0.8); }
  .venue-card { scroll-margin-top: 6rem; }
  .venue-card[data-selected] { border-color: #6366f1; box-shadow: 0 0 0 1px #6366f1, 0 8px 32px -8px rgb(99 102 241 / 0.45); }
  :global(.leaflet-container) { font-family: inherit; }
  :global(.leaflet-popup-content-wrapper) { border-radius: 14px; }
  :global(.dark .leaflet-popup-content-wrapper), :global(.dark .leaflet-popup-tip) { background: #18181b; color: #f4f4f5; }
  :global(.dark .leaflet-popup-content a) { color: #a5b4fc; }
  :global(.dark .leaflet-control-zoom a) { background: #18181b; color: #f4f4f5; border-color: #3f3f46; }
</style>
