---
import Layout from '../layouts/Layout.astro';
import { CURRENT_LEAGUE, CURRENT_LEAGUE_TITLE } from '../config/league';
import { VENUES_SEO } from '../config/seo';
import { groupVenues, loadVenues } from '../lib/venue-data';
import snapshot from '../data/venues.snapshot.json';
import locations from '../data/venue-locations.json';

export const prerender = true;

const entries = await loadVenues(CURRENT_LEAGUE.teams, {
  baseUrl: import.meta.env.TWOK_SOFTWARE_API_URL || CURRENT_LEAGUE.api.twokSoftwareBaseUrl,
  snapshot,
  locations,
});
const groups = groupVenues(entries);
// Only the data needed for markers is embedded in the static HTML.
const mapData = JSON.stringify(groups).replace(/</g, '\\u003c');
---

<Layout
  {...VENUES_SEO}
  showTeamSelector={false}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <a href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
      <span aria-hidden="true">←</span> Zum Dashboard
    </a>
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-sm font-semibold text-blue-600 dark:text-blue-400">{CURRENT_LEAGUE_TITLE}</p>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-100">Unsere Spielorte</h1>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">Von der nächsten Auswärtsfahrt bis zum Heimspiel: Hier findest du die Spielstätten aller Liga-Teams.</p>
      </div>
      <span class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-medium text-blue-800 dark:border-blue-800 dark:bg-blue-950 dark:text-blue-200">{entries.length} Teams · {groups.length} Spielorte auf der Karte</span>
    </div>

    <section aria-label="Karte der Spielorte" class="mb-8 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-200 px-4 py-3 dark:border-gray-700">
        <p class="text-sm text-gray-600 dark:text-gray-300">Wähle einen Marker oder einen Verein aus der Liste.</p>
        <button id="show-all-venues" type="button" hidden class="rounded-md px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 dark:text-blue-300 dark:hover:bg-gray-700">Alle Spielorte zeigen</button>
      </div>
      <div id="venue-map" class="venue-map" role="region" aria-label="Interaktive Karte der Spielstätten" tabindex="0">
        <p class="p-6 text-sm text-gray-600 dark:text-gray-300">Die Spielorte findest du auch in der Liste unterhalb der Karte.</p>
      </div>
      <p id="venue-map-status" role="status" class="border-t border-gray-200 px-4 py-3 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">Karte wird geladen. Alle Adressen und Kartenlinks sind bereits unten verfügbar.</p>
      <noscript><p class="px-4 pb-3 text-sm text-gray-600 dark:text-gray-300">Aktiviere JavaScript für die interaktive Karte. Die Vereinsliste und OpenStreetMap-Links funktionieren auch ohne JavaScript.</p></noscript>
    </section>

    <section aria-labelledby="venue-list-title">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <h2 id="venue-list-title" class="text-xl font-bold text-gray-900 dark:text-gray-100">Alle Vereine</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Alphabetisch nach Team</p>
      </div>
      <ul class="grid gap-4 md:grid-cols-2">
        {entries.map(entry => (
          <li id={`team-${entry.teamId}`} class="venue-card flex flex-col rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-gray-100">{entry.teamName}</h3>
            {entry.venue ? (
              <div class="mb-4 flex-1">
                <p class="font-medium text-gray-700 dark:text-gray-200">{entry.venue.name || 'Spielstätte'}</p>
                <address class="mt-1 not-italic text-gray-600 dark:text-gray-400">
                  {entry.venue.street && <>{entry.venue.street}<br /></>}
                  {[entry.venue.postalCode, entry.venue.city].filter(Boolean).join(' ')}
                </address>
                {!entry.location && <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Dieser Spielort ist noch nicht auf der Karte markiert.</p>}
              </div>
            ) : <p class="mb-4 flex-1 text-gray-500 dark:text-gray-400">Für dieses Team ist noch kein Spielort hinterlegt.</p>}
            <div class="flex flex-wrap items-center gap-2">
              {entry.location && <button type="button" data-show-venue={entry.teamId} hidden class="rounded-lg bg-blue-600 px-3 py-2.5 text-sm font-medium text-white hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Auf Karte zeigen</button>}
              {entry.osmUrl && <a href={entry.osmUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-500 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700">In OpenStreetMap öffnen <span aria-hidden="true">↗</span></a>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script is:inline id="venue-map-data" type="application/json" set:html={mapData} />
</Layout>

<script>
  import '../scripts/venue-map';
</script>

<style>
  .venue-map { position: relative; z-index: 0; height: clamp(300px, 52vh, 520px); background: #e8edf0; }
  :global(.dark) .venue-map { background: #1f2937; }
  .venue-card { scroll-margin-top: 6rem; }
  .venue-card[data-selected] { border-color: #3b82f6; box-shadow: 0 0 0 1px #3b82f6; }
  :global(.dark .leaflet-popup-content-wrapper), :global(.dark .leaflet-popup-tip) { background: #1f2937; color: #f3f4f6; }
  :global(.dark .leaflet-popup-content a) { color: #93c5fd; }
  :global(.dark .leaflet-control-zoom a) { background: #1f2937; color: #f3f4f6; border-color: #4b5563; }
</style>
