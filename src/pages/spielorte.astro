---
import Layout from '../layouts/Layout.astro';
import { CURRENT_LEAGUE, CURRENT_LEAGUE_TITLE } from '../config/league';
import { VENUES_SEO } from '../config/seo';
import Icon from '../components/Icon.astro';
import { groupVenues, loadVenues } from '../lib/venue-data';
import snapshot from '../data/venues.snapshot.json';
import locations from '../data/venue-locations.json';

export const prerender = true;

const entries = await loadVenues(CURRENT_LEAGUE.teams, {
  baseUrl: import.meta.env.TWOK_SOFTWARE_API_URL || CURRENT_LEAGUE.api.twokSoftwareBaseUrl,
  snapshot,
  locations,
});
const groups = groupVenues(entries);
// Only the data needed for markers is embedded in the static HTML.
const mapData = JSON.stringify(groups).replace(/</g, '\\u003c');
---

<Layout
  {...VENUES_SEO}
  showTeamSelector={false}
>
  <div class="mx-auto flex w-full max-w-[1320px] flex-col gap-6 px-4 pt-6 sm:px-6 lg:px-9 lg:pt-7">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex min-w-0 flex-col gap-1.5">
        <span class="label">{CURRENT_LEAGUE_TITLE}</span>
        <h1 class="heading text-2xl font-bold leading-tight sm:text-[28px]">Unsere Spielorte</h1>
        <p class="dimmed max-w-2xl">Von der nächsten Auswärtsfahrt bis zum Heimspiel: Hier findest du die Spielstätten aller Liga-Teams.</p>
      </div>
      <div class="flex gap-2">
        <span class="badge-gray">{entries.length} Teams</span>
        <span class="badge-gray">{groups.length} Spielorte auf der Karte</span>
      </div>
    </div>

    <section aria-label="Karte der Spielorte" class="paper overflow-hidden">
      <div class="paper-head flex-wrap">
        <p class="dimmed">Wähle einen Marker oder einen Verein aus der Liste.</p>
        <button id="show-all-venues" type="button" hidden class="btn-subtle min-h-[36px] px-3">Alle Spielorte zeigen</button>
      </div>
      <div id="venue-map" class="venue-map" role="region" aria-label="Interaktive Karte der Spielstätten" tabindex="0">
        <p class="dimmed p-6">Die Spielorte findest du auch in der Liste unterhalb der Karte.</p>
      </div>
      <p id="venue-map-status" role="status" class="divider dimmed border-t px-5 py-3 text-xs">Karte wird geladen. Alle Adressen und Kartenlinks sind bereits unten verfügbar.</p>
      <noscript><p class="dimmed px-5 pb-3">Aktiviere JavaScript für die interaktive Karte. Die Vereinsliste und OpenStreetMap-Links funktionieren auch ohne JavaScript.</p></noscript>
    </section>

    <section aria-labelledby="venue-list-title" class="flex flex-col gap-4">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="venue-list-title" class="paper-title">Alle Vereine</h2>
        <p class="dimmed text-xs">Alphabetisch nach Team</p>
      </div>
      <ul class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
        {entries.map(entry => (
          <li id={`team-${entry.teamId}`} class="venue-card paper flex flex-col gap-3 p-5">
            <h3 class="heading text-base font-bold leading-snug">{entry.teamName}</h3>
            {entry.venue ? (
              <div class="flex-1">
                <p class="heading font-medium">{entry.venue.name || 'Spielstätte'}</p>
                <address class="dimmed mt-0.5 not-italic">
                  {entry.venue.street && <>{entry.venue.street}<br /></>}
                  {[entry.venue.postalCode, entry.venue.city].filter(Boolean).join(' ')}
                </address>
                {!entry.location && <p class="dimmed mt-2 text-xs">Dieser Spielort ist noch nicht auf der Karte markiert.</p>}
              </div>
            ) : <p class="dimmed flex-1">Für dieses Team ist noch kein Spielort hinterlegt.</p>}
            <div class="flex flex-wrap items-center gap-2">
              {entry.location && <button type="button" data-show-venue={entry.teamId} hidden class="btn-filled">Auf Karte zeigen</button>}
              {entry.osmUrl && <a href={entry.osmUrl} target="_blank" rel="noopener noreferrer" class="btn-default">OpenStreetMap <Icon name="external" size={14} strokeWidth={1.6} /></a>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script is:inline id="venue-map-data" type="application/json" set:html={mapData} />
</Layout>

<script>
  import '../scripts/venue-map';
</script>

<style>
  .venue-map { position: relative; z-index: 0; height: clamp(320px, 55vh, 560px); background: #e9ecef; }
  :global(.dark) .venue-map { background: #1f1f1f; }
  :global(.dark) .venue-map :global(.leaflet-tile-pane) { filter: brightness(0.75) contrast(1.1) saturate(0.8); }
  .venue-card { scroll-margin-top: 6rem; }
  .venue-card[data-selected] { border-color: #b91c1c; box-shadow: 0 0 0 1px #b91c1c; }
  :global(.leaflet-container) { font-family: inherit; }
  :global(.leaflet-popup-content-wrapper) { border-radius: 12px; }
  :global(.leaflet-popup-content a) { color: #b91c1c; }
  :global(.dark .leaflet-popup-content-wrapper), :global(.dark .leaflet-popup-tip) { background: #2e2e2e; color: #c9c9c9; }
  :global(.dark .leaflet-popup-content a) { color: #fca5a5; }
  :global(.dark .leaflet-control-zoom a) { background: #2e2e2e; color: #c9c9c9; border-color: #424242; }
</style>
