---
import Layout from '../../layouts/Layout.astro';
import LiveMatchBoards from '../../components/svelte/LiveMatchBoards.svelte';

if (!import.meta.env.DEV) {
  return new Response('Not found', { status: 404 });
}
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<Layout title="Live-Boards testen · Fülltreffer" showTeamSelector={false}>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <a href="/" class="text-sm text-blue-700 hover:underline dark:text-blue-300">← Zum Dashboard</a>
    <h1 class="mt-4 text-2xl font-bold text-gray-900 dark:text-white">Live-Boards testen</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Zwei Boards mit Beispielspielern – nur auf dem lokalen Dev-Server verfügbar.</p>
    <LiveMatchBoards eventId="1" matchId="1" demo client:load />
  </div>
</Layout>
