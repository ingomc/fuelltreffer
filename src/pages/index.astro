---
import Layout from '../layouts/Layout.astro';
import ParticipantData from '../components/ParticipantData.astro';
import { CURRENT_LEAGUE, findLeagueTeam } from '../config/league';
import { HOME_SEO } from '../config/seo';

// Unknown or outdated team IDs lead to the default team instead of an empty dashboard.
const requestedTeamId = Astro.url.searchParams.get('team');
if (requestedTeamId !== null && !findLeagueTeam(requestedTeamId)) {
  const target = new URL(Astro.url);
  target.searchParams.delete('team');
  return Astro.redirect(target.pathname + target.search);
}

const selectedTeamId = requestedTeamId ?? CURRENT_LEAGUE.defaultParticipantId;
---

<Layout {...HOME_SEO}>
  <ParticipantData teamId={selectedTeamId} />
</Layout>
