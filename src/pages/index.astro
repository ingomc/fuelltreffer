---
import Layout from '../layouts/Layout.astro';
import ParticipantData from '../components/ParticipantData.astro';
import { CURRENT_LEAGUE } from '../config/league';
import { HOME_SEO } from '../config/seo';

// Get team ID from URL parameter or use default
const urlParams = new URLSearchParams(Astro.url.search);
const selectedTeamId = urlParams.get('team') || CURRENT_LEAGUE.defaultParticipantId;
---

<Layout {...HOME_SEO}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-200">
    <ParticipantData teamId={selectedTeamId} />
  </div>
</Layout>
